<Window x:Class="Conversion_Moneda_Prueba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Conversion_Moneda_Prueba"
        mc:Ignorable="d"
        Title="MainWindow" Height="527" Width="1005">

    <Grid Margin="0,0,0,-6">
        <Grid.Background>
            <ImageBrush ImageSource="/Prueba1.png"/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>


        <ComboBox x:Name="Pais_Origen" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="29" 
                  Margin="39,173,0,0" VerticalAlignment="Top" Width="154" SelectionChanged="ComboBox_SelectionChanged"
                  />

        <ComboBox x:Name="Pais_Destino" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="29" 
                  Margin="135,285,0,0" VerticalAlignment="Top" Width="154" SelectionChanged="Conversion_Pais_SelectionChanged"
                  />

        <Button x:Name="Conversion_Moneda" Content="Convertir" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="70" 
                Margin="135,370,0,0" VerticalAlignment="Top" Width="154" FontSize="20" Click="Conversion_Moneda_Click"/>

        <TextBox x:Name="Cantidad_Origen" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="29" 
                 Margin="232,173,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="164"/>

        <TextBlock Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="59" Margin="90,109,0,0" TextWrapping="Wrap" Text="Moneda de Origen y Cantidad" 
                   VerticalAlignment="Top" Width="252" FontSize="20" TextAlignment="Center"/>
        
        <TextBlock Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="35" Margin="90,237,0,0" TextWrapping="Wrap" Text="Moneda de Destino" 
                   VerticalAlignment="Top" Width="252" FontSize="20" TextAlignment="Center"/>
        
        <TextBlock Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="38" Margin="627,233,0,0" TextWrapping="Wrap" Text="Resultado de la Conversion" 
                   VerticalAlignment="Top" Width="252" FontSize="20" TextAlignment="Center" Background="#FFFDF9F9"/>

        <Label x:Name="Resultado_Conversion" Content="" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="126" 
               Margin="594,300,0,0" VerticalAlignment="Top" Width="318" Background="#FFF9F8F8"/>

        <TextBlock HorizontalAlignment="Center" Height="40" Margin="0,28,0,0" TextWrapping="Wrap" 
                   VerticalAlignment="Top" Width="252" FontSize="24" TextAlignment="Center" Grid.Column="1">
                  <Run Language="es-es" Text="Conversor de Monedas"/><LineBreak/><Run Language="es-es"/></TextBlock>

    </Grid>
</Window>
